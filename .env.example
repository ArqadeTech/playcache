# Public site URL (required in production for Steam OpenID return_to)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Modrinth personal token (mrp_…) — https://modrinth.com/settings/account
# Used to search mods and resolve jar download URLs.
MODRINTH_TOKEN=

# Optional CurseForge key if you prefer that catalog instead
CURSEFORGE_API_KEY=

# Random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string
