# Public site URL (required in production for Steam OpenID return_to)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Leave unset to use demo library mode.
STEAM_API_KEY=

# CurseForge for Studios API key — https://console.curseforge.com/
# Leave unset to use the built-in demo Minecraft mod catalog.
CURSEFORGE_API_KEY=

# Random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string
